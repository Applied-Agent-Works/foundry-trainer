@page "/"
@using demo.Models
@inject IAgentConversation Conversations

<PageTitle>Carrot evidence review</PageTitle>

<section class="hero-grid">
    <div>
        <span class="eyebrow">HUMAN-IN-THE-LOOP DEMONSTRATION</span>
        <h1>Ask the evidence.<br /><span>Keep the decision yours.</span></h1>
        <p class="lede">
            This screen is the handoff between deterministic local evidence and
            three no-tools Foundry roles: the Evidence Analyst, its independent
            Judge, and the bounded Proposal Drafter. The displayed receipts are
            redacted and replayable so the review conversation is safe to capture.
        </p>
        <div class="guard-row">
            <span>✓ packet-bound</span>
            <span>✓ no source mutation</span>
            <span>✓ review required</span>
        </div>
    </div>
    <aside class="evidence-card">
        <div class="card-label">CURRENT EVIDENCE PACKET</div>
        <div class="metric"><strong>4</strong><span>declared candidates</span></div>
        <div class="metric"><strong>2</strong><span>decision seats</span></div>
        <div class="metric"><strong>1</strong><span>fixed smoke seed</span></div>
        <div class="status-line"><span class="status-dot"></span> deterministic gate passed</div>
        <small>Interpretation remains pending human review.</small>
    </aside>
</section>

<section class="orientation-card">
    <div class="section-kicker">START HERE</div>
    <h2>What are we running?</h2>
    <p>
        You are looking at one review cycle, not a free-form chat. The local
        farming agents already produced controlled simulation evidence. The
        Foundry agents interpret that evidence. You choose which recorded step
        to inspect, then decide whether a new bounded test is worth approving.
    </p>
    <div class="orientation-grid">
        <div><strong>Inner loop</strong><span>Runs deterministic farming simulations, checkpoints, replays, and clean audits.</span></div>
        <div><strong>Outer loop</strong><span>Explains evidence, judges explanation quality, and frames one next question.</span></div>
        <div><strong>Human boundary</strong><span>Approves, rejects, or defers the next experiment envelope.</span></div>
    </div>
</section>

<section class="execution-console" aria-label="Guided execution console">
    <div class="console-heading">
        <div>
            <div class="section-kicker">GUIDED PLAYBACK</div>
            <h2>Walk through one review cycle</h2>
        </div>
        <span class="receipt-badge">recorded receipts · no new side effects</span>
    </div>
    <div class="wizard-intro"><strong>Step @SelectedRunOption.Number of 04</strong><span>Select a step directly or use Next to follow the system’s normal order.</span></div>
    <div class="run-options">
        @foreach (var option in RunOptions)
        {
            <button class="run-option @(selectedRun == option.Id ? "selected" : "")" @onclick="() => SelectRun(option.Id)">
                <span class="run-number">@option.Number</span>
                <span><strong>@option.Title</strong><small>@option.ShortDescription</small></span>
            </button>
        }
    </div>
    <div class="run-detail">
        <div>
            <div class="section-kicker">SELECTED STEP</div>
            <h3>@SelectedRunOption.Title</h3>
            <p>@SelectedRunOption.Explanation</p>
        </div>
        <div class="run-contract">
            <div><span>Consumes</span><strong>@SelectedRunOption.Input</strong></div>
            <div><span>Produces</span><strong>@SelectedRunOption.Output</strong></div>
            <div><span>Side effect</span><strong>@SelectedRunOption.SideEffect</strong></div>
        </div>
        <button class="play-button" @onclick="PlaySelectedRun">▶ Play this step</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(playbackStatus))
    {
        <div class="playback-status"><span class="status-dot"></span>@playbackStatus</div>
    }
    <div class="wizard-nav">
        <button class="wizard-button" disabled="@(selectedRun == RunOptions[0].Id)" @onclick="PreviousRun">← Back</button>
        <span>Review step @SelectedRunOption.Number / 04</span>
        <button class="wizard-button primary" disabled="@(selectedRun == RunOptions[^1].Id)" @onclick="NextRun">Next step →</button>
    </div>
</section>

<section class="uml-card" aria-label="UML-style execution map">
    <div class="section-kicker">EXECUTION MAP</div>
    <h2>How one review cycle moves through the system</h2>
    <p class="muted">Read left to right. The arrows show data flow; the gold boundary is where a human decision is required.</p>
    <div class="uml-flow">
        <div class="uml-node inner"><span>INNER LOOP</span><strong>Deterministic farming agents</strong><small>simulate → checkpoint → replay → clean audit</small></div>
        <div class="uml-arrow">→</div>
        <div class="uml-node evidence"><span>PACKET</span><strong>Audited evidence</strong><small>candidates · deltas · divergence · provenance</small></div>
        <div class="uml-arrow">→</div>
        <div class="uml-node foundry"><span>FOUNDRY ROLE 1</span><strong>Evidence Analyst</strong><small>explain only; cite and preserve limits</small></div>
        <div class="uml-arrow">→</div>
        <div class="uml-node judge"><span>FOUNDRY ROLE 2</span><strong>Analyst Judge</strong><small>score grounding and boundedness</small></div>
        <div class="uml-arrow">→</div>
        <div class="uml-node human"><span>HUMAN BOUNDARY</span><strong>You decide</strong><small>retain · approve · reject</small></div>
    </div>
    <div class="uml-return"><span>approved envelope returns to the inner loop</span><b>↺</b></div>
</section>

<section class="loop-strip" aria-label="Double loop status">
    <div class="loop-step complete"><span>01</span><strong>Inner loop</strong><small>audited evidence</small></div>
    <div class="loop-arrow">→</div>
    <div class="loop-step complete"><span>02</span><strong>Evidence analyst</strong><small>packet-backed explanation</small></div>
    <div class="loop-arrow">→</div>
    <div class="loop-step active"><span>03</span><strong>Human review</strong><small>decision still yours</small></div>
    <div class="loop-arrow">→</div>
    <div class="loop-step"><span>04</span><strong>Next envelope</strong><small>only after approval</small></div>
</section>

<section class="workbench" aria-label="Agent chat workbench">
    <div class="agent-rail">
        <div class="section-kicker">CHOOSE A ROLE</div>
        @foreach (var agent in Conversations.Agents)
        {
            <button class="agent-choice @(agent.Id == selectedAgentId ? "selected" : "")"
                    @onclick="() => SelectAgent(agent.Id)">
                <span class="agent-icon">@agent.ShortName</span>
                <span class="agent-copy">
                    <strong>@agent.DisplayName</strong>
                    <small>@agent.Description</small>
                </span>
                <span class="chevron">›</span>
            </button>
        }
        <div class="review-note">
            <strong>Human review</strong>
            <p>Neither role can approve a candidate or edit policy source.</p>
            <label><input type="checkbox" @bind="reviewAcknowledged" /> I understand this is a proposal</label>
        </div>
    </div>

    <div class="chat-panel">
        <div class="chat-header">
            <div>
                <div class="section-kicker">ACTIVE ROLE</div>
                <h2>@ActiveAgent.DisplayName</h2>
            </div>
            <span class="role-status">@ActiveAgent.Status</span>
        </div>

        <div class="messages" aria-live="polite">
            @foreach (var message in Messages)
            {
                <article class="message @(message.Role == "human" ? "human" : "agent")">
                    <div class="message-meta">@(message.Role == "human" ? "YOU" : ActiveAgent.DisplayName.ToUpperInvariant())</div>
                    <p>@message.Text</p>
                </article>
            }
        </div>

        <div class="composer">
            <textarea @bind="question" placeholder="Ask what the evidence supports..." aria-label="Question"></textarea>
            <button class="send-button" disabled="@(string.IsNullOrWhiteSpace(question) || !reviewAcknowledged)" @onclick="SendMessage">Send question</button>
            @if (!reviewAcknowledged)
            {
                <small>Check the human-review acknowledgement to continue the review.</small>
            }
        </div>
    </div>
</section>

<section class="decision-grid" aria-label="Human decision packet">
    <article class="decision-card evidence-summary">
        <div class="section-kicker">DETERMINISTIC EVIDENCE</div>
        <h2>What the packet says</h2>
        <p class="muted">One seed · two seats · four declared values · all clean audits passed.</p>
        <table>
            <thead><tr><th>Candidate</th><th>Paired Δ</th><th>Divergence</th><th>Audit</th></tr></thead>
            <tbody>
                <tr><td>10</td><td>0</td><td>none</td><td><span class="pass">passed</span></td></tr>
                <tr><td>40</td><td>0</td><td>none</td><td><span class="pass">passed</span></td></tr>
                <tr><td>60</td><td>0</td><td>none</td><td><span class="pass">passed</span></td></tr>
                <tr class="highlight"><td>80</td><td>+937</td><td>turn 107</td><td><span class="pass">passed</span></td></tr>
            </tbody>
        </table>
        <ul class="limits"><li>Descriptive smoke evidence only.</li><li>Not a ranking or global optimum.</li><li>No policy mutation is authorized.</li></ul>
    </article>

    <article class="decision-card proposal-card">
        <div class="section-kicker">BOUNDED PROPOSAL</div>
        <h2>What the next role suggests</h2>
        <div class="proposal-value"><span>parameter</span><strong>seed_opportunity_value</strong></div>
        <div class="proposal-value"><span>current → proposed</span><strong>20 → 40</strong></div>
        <p>Run a separately approved held-out seed and seat suite with the same clean-audit requirement.</p>
        <span class="review-pill">pending_human_review</span>
    </article>

    <article class="decision-card human-card">
        <div class="section-kicker">YOUR DECISION</div>
        <h2>Choose the next boundary</h2>
        <p class="muted">These buttons record a review disposition locally. They do not run a test or change policy.</p>
        <div class="decision-buttons">
            <button class="decision-button retain" disabled="@(!reviewAcknowledged)" @onclick='() => RecordDecision("retain_baseline")'>Retain baseline</button>
            <button class="decision-button approve" disabled="@(!reviewAcknowledged)" @onclick='() => RecordDecision("approve_held_out_test")'>Approve held-out test</button>
            <button class="decision-button reject" disabled="@(!reviewAcknowledged)" @onclick='() => RecordDecision("reject_proposal")'>Reject proposal</button>
        </div>
        @if (!string.IsNullOrWhiteSpace(decisionStatus))
        {
            <div class="decision-status"><span class="status-dot"></span>@decisionStatus</div>
        }
        else
        {
            <small class="decision-hint">A checked acknowledgement enables the review controls.</small>
        }
    </article>
</section>

@code {
    private sealed record RunOption(string Id, string Number, string Title, string ShortDescription, string Explanation, string Input, string Output, string SideEffect);

    private static readonly IReadOnlyList<RunOption> RunOptions =
    [
        new("inner", "01", "Inspect inner-loop evidence", "Read the audited simulation result", "This step shows what the deterministic farming agents actually did. It does not rerun a game; it replays the recorded receipt so you can inspect the evidence before trusting an explanation.", "audited packet", "candidate table + provenance", "none"),
        new("analyst", "02", "Ask the Evidence Analyst", "Explain the packet in plain language", "This step sends only the redacted evidence brief to the constrained analyst role. It may explain facts and limitations, but it cannot rank candidates or approve a policy change.", "redacted evidence brief", "cited explanation", "recorded response only"),
        new("judge", "03", "Inspect the Analyst Judge", "Check explanation quality independently", "This step checks whether the analyst stayed grounded, cited the packet, preserved limitations, and respected the review boundary. It does not judge game reward.", "brief + analyst response", "quality score + reasons", "recorded judge receipt"),
        new("proposal", "04", "Review the Proposal Drafter", "Frame one bounded next test", "This step turns the accepted handoff into one proposed measurement. It is still a proposal: selecting it here does not create a contract or start a simulation.", "validated analyst + judge context", "one next-test proposal", "human approval required"),
    ];

    private string selectedAgentId = "evidence-analyst";
    private string selectedRun = "inner";
    private string question = string.Empty;
    private bool reviewAcknowledged;
    private string decisionStatus = string.Empty;
    private string playbackStatus = string.Empty;
    private List<ChatMessage> Messages = new();

    private AgentProfile ActiveAgent => Conversations.GetAgent(selectedAgentId);
    private RunOption SelectedRunOption => RunOptions.First(option => option.Id == selectedRun);

    protected override void OnInitialized()
    {
        Messages = Conversations.StartConversation(selectedAgentId).ToList();
    }

    private void SelectAgent(string agentId)
    {
        selectedAgentId = agentId;
        Messages = Conversations.StartConversation(agentId).ToList();
        question = string.Empty;
    }

    private void SelectRun(string runId)
    {
        selectedRun = runId;
        playbackStatus = string.Empty;
    }

    private void PlaySelectedRun()
    {
        playbackStatus = $"Played {SelectedRunOption.Title}. This was a recorded receipt; no new simulator, model call, or policy change occurred.";
    }

    private void PreviousRun()
    {
        var index = RunOptions.ToList().FindIndex(option => option.Id == selectedRun);
        if (index > 0)
        {
            selectedRun = RunOptions[index - 1].Id;
            playbackStatus = string.Empty;
        }
    }

    private void NextRun()
    {
        var index = RunOptions.ToList().FindIndex(option => option.Id == selectedRun);
        if (index >= 0 && index < RunOptions.Count - 1)
        {
            selectedRun = RunOptions[index + 1].Id;
            playbackStatus = string.Empty;
        }
    }

    private void SendMessage()
    {
        if (string.IsNullOrWhiteSpace(question) || !reviewAcknowledged)
        {
            return;
        }

        var submitted = question.Trim();
        Messages.Add(new ChatMessage("human", submitted));
        Messages.Add(new ChatMessage("agent", Conversations.Reply(ActiveAgent, submitted)));
        question = string.Empty;
    }

    private void RecordDecision(string decision)
    {
        if (!reviewAcknowledged)
        {
            return;
        }

        decisionStatus = $"Recorded locally: {decision}. No experiment or source change was performed.";
    }
}
