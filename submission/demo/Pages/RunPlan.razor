@page "/run-plan"
@using demo.Models
@using System.Net.Http.Json
@using System.Text.Json
@inject WorkbenchState Workbench
@inject HttpClient Backend

<PageTitle>Run plan</PageTitle>

<section class="screen-heading">
    <div class="section-kicker">SCREEN 02 · PLAN BEFORE EXECUTION</div>
    <h1>Inspect the proposed run.</h1>
      <p>Before anything runs, this is where a human can see and edit the bounded envelope. Editing changes only the in-memory proposal until the run is submitted.</p>
</section>

<section class="control-flow-card" aria-label="Carrot runtime control-flow graph">
    <label class="decision-graph-selector unified-graph-selector">Deterministic agent<select aria-label="Decision graph" value="@Workbench.Plan.GraphId" @onchange="GraphChanged"><option value="carrot_investment">Carrot</option><option value="wheat_crop" disabled>Wheat · adapter pending</option><option value="melon_investment" disabled>Watermelon / Melon · adapter pending</option></select></label>
    <div class="section-kicker">CARROT DETERMINISTIC AGENT · UNIFIED DECISION MAP</div>
    <h2>Where the knobs enter, and what the agent does next</h2>
    <p class="muted">Choose one parameter from the economic gate, then follow the runtime branches below. The parameter cards are the only editing surface; the action branches are read-only.</p>
    <div class="gate-and-influence-layout @(economicGateFocused ? "visible" : "hidden")">
        <div class="gate-controls-column">
    @if (economicGateFocused)
    {
        <div class="economic-input-map" aria-label="Economic decision graph knobs">
            <div class="economic-input-heading"><span>ECONOMIC GATE · PARAMETER CHOICES</span><small>Choose one knob to test. The other graph branches have no tuning controls.</small></div>
            <div class="economic-knob-groups">
                @foreach (var group in EconomicParameterGroups)
                {
                    <section class="economic-knob-group">
                        <span class="economic-knob-group-title">@group.Title</span>
                        <small>@group.Description</small>
                        <div class="economic-knob-list">
                            @foreach (var parameterName in group.ParameterNames)
                            {
                                var evidence = Workbench.ParametersForSelectedGraph.FirstOrDefault(item => item.Name == parameterName);
                                if (evidence is not null)
                                {
                                    <button class="economic-knob priority-@evidence.Priority @(showEditor && editorParameterName == evidence.Name ? "selected" : "") @(IsModified(evidence) ? "modified" : "")" data-tooltip="Tested: @evidence.Tested. Result: @evidence.Result. Why: @evidence.Why" @onclick="() => SelectParameter(evidence)">
                                        <strong>@evidence.Name</strong>
                                        <span>baseline @evidence.Baseline</span>
                                        @if (IsModified(evidence))
                                        {
                                            <small>MODIFIED · proposed @(Workbench.Plan.ProposedValue.ToString("0.##"))</small>
                                        }
                                    </button>
                                }
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    }

    @if (economicGateFocused && showEditor && EditorParameterEvidence is { } inlineEvidence)
    {
        <section class="inline-parameter-editor" aria-label="Inline parameter editor">
            <div class="inline-editor-heading">
                <div>
                    <div class="section-kicker">EDIT ONE PARAMETER</div>
                    <h2>@inlineEvidence.Name</h2>
                </div>
                <button type="button" class="inline-editor-cancel" @onclick="CloseEditor">Cancel</button>
            </div>
            <p class="muted">This is the only editing surface. The run contract accepts one parameter override; choosing another knob replaces this draft, while Cancel leaves the committed change untouched.</p>
            <div class="inline-editor-grid">
                <label>Proposed value<select @bind="editorProposedValue">
                    <option class="baseline-option" value="@editorBaselineValue">@(editorBaselineValue.ToString("0.####")) · baseline</option>
                    @foreach (var value in WorkbenchState.ProposedValuesFor(inlineEvidence))
                    {
                        <option value="@value">@value.ToString("0.####")</option>
                    }
                </select></label>
                <div class="selected-evidence @(IsEditorModified ? "modified-evidence" : "")">
                    <p>Baseline: <b>@inlineEvidence.Baseline</b> · Tested: <b>@inlineEvidence.Tested</b></p>
                    <p class="muted"><b class="priority-@inlineEvidence.Priority">@inlineEvidence.Priority priority</b> — @inlineEvidence.Why</p>
                    <p class="muted"><b>In plain English:</b> @PlainEnglishEvidence(inlineEvidence)</p>
                </div>
            </div>
            <div class="inline-editor-actions">
                <button type="button" class="wizard-button" @onclick="CloseEditor">Cancel</button>
                <button type="button" class="wizard-button primary" @onclick="CommitEditor">Done</button>
            </div>
        </section>
    }
        </div>

    @if (economicGateFocused && showEditor && EditorParameterEvidence is { } focusedEvidence)
    {
        var influence = WorkbenchState.InfluenceFor(focusedEvidence.Name);
        <section class="influence-card unified-influence-card">
            <div class="section-kicker">PARAMETER INFLUENCE</div>
            <h2>How the selected knob fits into the decision</h2>
            <div class="modal-influence-flow main-influence-flow">
                <div class="modal-influence-group">
                    <span class="relationship-label">UPSTREAM</span>
                    @foreach (var upstream in influence.Upstream)
                    {
                        <button class="relation-chip kind-@upstream.Kind @(modalRelationLabel == upstream.Label ? "active" : "")" @onclick="() => FocusUpstream(upstream.Label)">@upstream.Label</button>
                    }
                </div>
                <b aria-hidden="true">→</b>
                <button class="relation-chip parameter-chip kind-parameter @(modalRelationKind == "parameter" ? "active" : "")" @onclick="() => FocusParameter(focusedEvidence.Name)">@focusedEvidence.Name</button>
                <b aria-hidden="true">→</b>
                <div class="modal-influence-group">
                    <span class="relationship-label">DOWNSTREAM</span>
                    @foreach (var downstream in influence.Downstream)
                    {
                        <button class="relation-chip kind-@downstream.Kind @(modalRelationLabel == downstream.Label ? "active" : "")" @onclick="() => FocusDownstream(downstream.Label)">@downstream.Label</button>
                    }
                </div>
            </div>
            @if (influence.Related.Any(node => node.Label != focusedEvidence.Name))
            {
                <div class="related-parameter-list">
                    <span class="relationship-label">OTHER PARAMETERS IN THIS CALCULATION</span>
                    @foreach (var related in influence.Related.Where(node => node.Label != focusedEvidence.Name))
                    {
                        <button class="relation-chip kind-@related.Kind @(modalRelationLabel == related.Label ? "active" : "")" @onclick="() => FocusRelated(related.Label)">@related.Label</button>
                    }
                </div>
            }
            <p class="muted"><b>In plain English:</b> @RelationshipCaption(focusedEvidence, influence)</p>
        </section>
    }
    </div>
    <div class="control-flow-legend">
        <span><b class="legend-swatch decision-swatch"></b>decision point</span>
        <span><b class="legend-swatch action-swatch"></b>action taken when the answer is yes</span>
        <span><b class="legend-swatch continue-swatch"></b>no: continue along the main path</span>
    </div>
    <div class="control-flow-scroll">
        <div class="control-flow-spine-label">NO / CONTINUE</div>
        <div class="control-flow-spine">
            <article class="control-flow-node start-node">
                <span>START</span>
                <strong>Read the current observation</strong>
                <small>day · farmer tile · crops · seeds · money</small>
            </article>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <article class="control-flow-node decision-node">
                    <span>PRIORITY 1</span>
                    <strong>Current tile needs water?</strong>
                    <small>Protect an existing crop before investing.</small>
                </article>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>WATER</strong><small>Care takes priority.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <article class="control-flow-node decision-node">
                    <span>PRIORITY 2</span>
                    <strong>Current tile is peak-ready?</strong>
                    <small>Harvest only when the crop is ready.</small>
                </article>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>HARVEST</strong><small>Collect the ready crop.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <button type="button" class="control-flow-node decision-node priority-gate-node @(economicGateFocused ? "focused" : "")" @onclick="FocusEconomicGate">
                    <span>PRIORITY 3</span>
                    <strong>Empty tile, seed, horizon, and utility beats PASS?</strong>
                    <small>Reads the economic gate above; this is where the plant/pass result becomes actionable.</small>
                    @if (Workbench.Plan.ProposedValue != Workbench.Plan.BaselineValue)
                    {
                        <span class="control-flow-gate-status changed">KNOB CHANGED · @Workbench.Plan.ParameterName = @Workbench.Plan.ProposedValue.ToString("0.####") <em>(baseline @Workbench.Plan.BaselineValue.ToString("0.####"))</em></span>
                    }
                    else
                    {
                        <span class="control-flow-gate-status">NO KNOB CHANGED · using baseline values</span>
                    }
                    <span class="control-flow-gate-hint">@(economicGateFocused ? "KNOB CHOICES SHOWN ABOVE" : "CLICK TO SHOW 12 TUNING KNOBS")</span>
                </button>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>PLANT CARROT</strong><small>Use the seed on the current tile.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <article class="control-flow-node decision-node">
                    <span>PRIORITY 4</span>
                    <strong>Any care work elsewhere?</strong>
                    <small>Find the nearest watering target before harvest work.</small>
                    <span class="control-flow-fixed">FIXED CARE RULE · no tunable knob</span>
                </article>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>MOVE TO WATER</strong><small>Take one Manhattan step.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <article class="control-flow-node decision-node">
                    <span>PRIORITY 5</span>
                    <strong>Any crop is ready elsewhere?</strong>
                    <small>Harvest work comes after watering work.</small>
                    <span class="control-flow-fixed">FIXED CARE RULE · no tunable knob</span>
                </article>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>MOVE TO HARVEST</strong><small>Take one Manhattan step.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <div class="control-flow-step">
                <article class="control-flow-node decision-node">
                    <span>PRIORITY 6</span>
                    <strong>May the policy invest?</strong>
                    <small>If yes, move toward an empty planting tile.</small>
                    <span class="control-flow-fixed">USES THE ECONOMIC GATE ABOVE</span>
                </article>
                <div class="control-flow-yes"><b>YES</b><span>↓</span></div>
                <article class="control-flow-node action-node"><span>ACTION</span><strong>MOVE TO PLANT</strong><small>Otherwise the final action is PASS.</small></article>
            </div>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <article class="control-flow-node pass-node"><span>NO</span><strong>PASS</strong><small>No safe or worthwhile action remains this turn.</small></article>
        </div>
    </div>
    <div class="market-flow">
        <div class="market-flow-label">MARKET ORDERS RUN ALONGSIDE THE FARMER ACTION</div>
        <div class="market-flow-row">
            <article class="control-flow-node market-node"><span>1</span><strong>Sell stored carrots</strong><small>If the shed has any.</small></article>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <article class="control-flow-node market-node"><span>2</span><strong>Investing?</strong><small>No: stop after selling.</small></article>
            <span class="control-flow-arrow" aria-hidden="true">→</span>
            <article class="control-flow-node market-node"><span>3</span><strong>Buy seeds if legal</strong><small>Empty space, affordability, seed need, and season horizon must all pass.</small></article>
        </div>
    </div>
    <p class="form-note">This is a static reading aid, not a live execution trace. It separates “what influences the decision” from “what the agent does next.”</p>
</section>

<section class="execution-workbench">
    <div class="section-kicker">LIVE RUN RECEIPT</div>
    <div class="execution-actions">
        <button class="wizard-button" disabled="@(running || IsFirstReceiptTab)" @onclick="BackOneStep">← Back one step</button>
        <button class="play-button" disabled="@(running || activeStageId != "plan" || !Workbench.LiveRunSupported)" @onclick="ExecuteCurrentStep">@(running ? "Running…" : "▶ Run approved experiment")</button>
        <button class="wizard-button" disabled="@(running || IsLastReceiptTab)" @onclick="ForwardOneStep">Forward one step →</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(status))
    {
        <div class="playback-status"><span class="status-dot"></span>@status</div>
    }
    <div class="run-stages horizontal">
        @foreach (var stage in Workbench.RunStages)
        {
            var displayStatus = StageDisplayStatus(stage);
            <button type="button" class="run-stage @displayStatus @(stage.Id == "packet" ? "final-stage" : "") @(activeStageId == stage.Id ? "stage-tab-active" : "")" @onclick="() => SelectReceiptStage(stage.Id)"><span class="stage-mark">@StageDisplayMark(displayStatus)</span><span><strong>@stage.Title</strong><em class="stage-state">@StageStateLabel(displayStatus)</em><small>@StageDisplayDetail(stage, displayStatus)</small></span></button>
        }
    </div>
    <div class="run-cycle-indicator">
        <span class="run-cycle-symbol" aria-hidden="true">↻</span>
        <span><strong>This is a tuning cycle.</strong> After the evidence and Foundry review are complete, the next bounded experiment returns to the plan at the beginning. Each cycle changes one approved knob, measures it, and feeds the evidence into the next decision.</span>
    </div>

    @if (CurrentGuidanceStage is { } guidance)
    {
        <article class="stage-explanation-card @(guidance.Id == "packet" && guidance.Status == "complete" ? "stage-explanation-final" : "")">
            <div class="section-kicker">WHAT THIS STEP MEANS</div>
            <h2>@GuidanceTitle(guidance)</h2>
            <p class="run-current-status"><strong>Currently:</strong> @CurrentRunStatus(guidance)</p>
            <p>@GuidanceText(guidance)</p>
            @if (guidance.Id == "plan")
            {
                <section class="plan-editor-panel">
                    <div class="run-selection-indicator">
                        <div class="section-kicker">SELECTED RUN PLAN</div>
                        <div class="run-selection-grid">
                            <div><span>Changed parameter</span><strong>@Workbench.Plan.ParameterName</strong></div>
                            <div><span>Baseline</span><strong>@Workbench.Plan.BaselineValue.ToString("0.####")</strong></div>
                            <div><span>Proposed value</span><strong>@Workbench.Plan.ProposedValue.ToString("0.####")</strong></div>
                        </div>
                        @if (CurrentRunEvidence is { } runEvidence)
                        {
                            <p>@RunSelectionStory(runEvidence)</p>
                        }
                    </div>
                    <div class="execution-fields">
                        <div class="execution-control-grid">
                            <label>Seeds<input @bind="Workbench.Plan.Seeds" @bind:after="ValidatePlanAsync" /></label>
                            <label>Steps<input type="number" @bind="Workbench.Plan.Steps" @bind:after="ValidatePlanAsync" /></label>
                            <div class="seat-table">
                                <div class="seat-table-header"><span>Seat</span><span>Player assignment</span></div>
                                <div class="seat-row"><strong>Seat 1</strong><select @bind="Workbench.Plan.SeatOneRole" @bind:after="ValidatePlanAsync"><option value="our_agent">Our Carrot agent</option><option value="opponent">Deterministic opponent</option></select></div>
                                <div class="seat-row"><strong>Seat 2</strong><select @bind="Workbench.Plan.SeatTwoRole" @bind:after="ValidatePlanAsync"><option value="our_agent">Our Carrot agent</option><option value="opponent">Deterministic opponent</option></select></div>
                                <small class="field-help">Assign exactly one tested agent and one opponent.</small>
                            </div>
                            <label>Opponent model<select @bind="Workbench.Plan.OpponentMode" @bind:after="ValidatePlanAsync"><option value="deterministic_conveyor">Deterministic conveyor</option><option value="recorded_baseline">Recorded baseline receipt</option></select></label>
                            <label>Execution mode<select @bind="Workbench.Plan.ExecutionMode" @bind:after="ValidatePlanAsync"><option value="full_simulator">Full simulator run</option><option value="receipt_preview">Recorded receipt preview</option></select></label>
                            <label>Divergence strategy<select @bind="Workbench.Plan.DivergenceStrategy" @bind:after="ValidatePlanAsync"><option value="first_action_then_suffix">First divergence + suffix</option><option value="full_clean_only">Full clean run only</option><option value="no_replay">No replay optimization</option></select></label>
                            <label class="audit-toggle"><input type="checkbox" @bind="Workbench.Plan.CleanAuditRequired" @bind:after="ValidatePlanAsync" /> Clean full-run audit required</label>
                        </div>
                    </div>
                </section>
            }
            else
            {
                <p class="stage-placeholder">This stage will show its recorded inputs, outputs, and any controls needed for this part of the run. For now, the workflow is represented by the receipt timeline above.</p>
            }
            @if (guidance.Id == "packet" && guidance.Status == "complete" && Workbench.LastRunResult is { } result)
            {
                <div class="stage-result-summary">
                    <div class="section-kicker">CONGRATULATIONS · RESULTS IN PLAIN ENGLISH</div>
                    <p>@result.PlainEnglish</p>
                    <p class="muted">This describes this exact approved suite. It is not a global claim and it does not automatically change policy.</p>
                </div>
            }
        </article>
    }

</section>

<section class="coverage-card">
    <div class="section-kicker">TEST COVERAGE PLAN</div>
    <h2>What evidence do we require?</h2>
    <p class="muted">Select the scenarios this proposed run must cover. This is a planning checklist, not a claim that every selected test has already executed.</p>
    <div class="coverage-meter"><span style="width:@Workbench.CoveragePercent%"></span></div>
    <strong>@Workbench.CoverageCount of @Workbench.TestScenarios.Count scenarios selected · @Workbench.CoveragePercent%</strong>
    <div class="coverage-grid">
        @foreach (var scenario in Workbench.TestScenarios)
        {
            <label class="coverage-item"><input type="checkbox" checked="@scenario.Included" @onchange="_ => ToggleScenario(scenario.Id)" /><span><strong>@scenario.Title</strong><small>@scenario.Description</small></span></label>
        }
    </div>
</section>

@code {
    private string status = string.Empty;
    private bool? planValidationValid;
    private string planValidationMessage = "Validating the current plan…";
    private bool running;
    private string activeStageId = "plan";
    private string? activeRunId;
    private bool showEditor;
    private bool economicGateFocused;
    private string editorParameterName = string.Empty;
    private double editorBaselineValue;
    private double editorProposedValue;
    private string modalRelationKind = "parameter";
    private string modalRelationLabel = string.Empty;
    private string modalRelationNodeKind = "parameter";

    private static readonly IReadOnlyList<EconomicParameterGroup> EconomicParameterGroups =
    [
        new("SUPPLY BELIEF", "How visible opponent crops change the supply estimate.", ["supply_high_given_zero_ripe", "supply_high_given_one_to_three_ripe", "supply_high_given_four_plus_ripe"]),
        new("PRICE MODEL", "How supply and demand become an expected sale price.", ["low_price_multiplier", "high_price_multiplier", "low_price_base", "low_price_supply_weight", "high_price_base", "high_price_demand_weight", "high_price_supply_penalty"]),
        new("VALUE", "How valuable it is to spend an owned seed now.", ["seed_opportunity_value"]),
        new("ACTION", "How attractive passing is compared with planting.", ["pass_utility"]),
    ];

    private sealed record EconomicParameterGroup(string Title, string Description, IReadOnlyList<string> ParameterNames);

    private bool IsModified(ParameterEvidence evidence) =>
        Workbench.Plan.ParameterName == evidence.Name && Workbench.Plan.ProposedValue != Workbench.Plan.BaselineValue;

    private ParameterEvidence? EditorParameterEvidence =>
        string.IsNullOrWhiteSpace(editorParameterName)
            ? null
            : Workbench.ParametersForSelectedGraph.FirstOrDefault(item => item.Name == editorParameterName);

    private ParameterEvidence? CurrentRunEvidence =>
        Workbench.ParametersForSelectedGraph.FirstOrDefault(item => item.Name == Workbench.Plan.ParameterName);

    private bool IsEditorModified => editorProposedValue != editorBaselineValue;

    protected override async Task OnInitializedAsync()
    {
        activeStageId = "plan";
        await ValidatePlanAsync();
    }

    private async Task ValidatePlanAsync()
    {
        try
        {
            using var response = await Backend.PostAsJsonAsync("api/run-plans/validate", new BackendRunRequest(
                Workbench.Plan.GraphId,
                Workbench.Plan.ParameterName,
                Workbench.Plan.BaselineValue,
                Workbench.Plan.ProposedValue,
                [42],
                [0, 1],
                Workbench.Plan.Steps));
            if (response.IsSuccessStatusCode)
            {
                planValidationValid = true;
                planValidationMessage = "The current plan passed structural validation.";
                return;
            }

            var refusal = await response.Content.ReadAsStringAsync();
            planValidationValid = false;
            planValidationMessage = DescribeBackendRefusal(refusal);
        }
        catch (Exception error)
        {
            planValidationValid = false;
            planValidationMessage = $"Validation could not run: {error.Message}";
        }
    }

    private void FocusEconomicGate()
    {
        economicGateFocused = !economicGateFocused;
        status = economicGateFocused
            ? "Economic gate selected. Choose one parameter to inspect or test."
            : "Economic gate choices hidden. The runtime branches remain unchanged.";
    }

    private void FocusRelation(string kind, string label, string nodeKind)
    {
        modalRelationKind = kind;
        modalRelationLabel = label;
        modalRelationNodeKind = nodeKind;
    }

    private void FocusUpstream(string label) => FocusRelation("upstream", label, "parameter");
    private void FocusDownstream(string label) => FocusRelation("downstream", label, "parameter");
    private void FocusParameter(string label) => FocusRelation("parameter", label, "parameter");
    private void FocusRelated(string label) => FocusRelation("related", label, "parameter");

    private string RelationshipCaption(ParameterEvidence evidence, ParameterInfluence influence) => modalRelationKind switch
    {
        "upstream" => $"{modalRelationLabel} is a {modalRelationNodeKind} input to {evidence.Name}. It helps determine the value this parameter is allowed to influence; it is not itself being changed in this run.",
        "downstream" => $"{evidence.Name} feeds the {modalRelationNodeKind} {modalRelationLabel}. Changing this parameter can affect that later calculation, but the exact effect still depends on the game state.",
        "related" => $"{modalRelationLabel} is another adjustable input in the same calculation neighborhood as {evidence.Name}. They contribute to a shared derived value; that does not mean one parameter changes the other.",
        _ => influence.Explanation,
    };

    private ParameterEvidence? FocusedEvidence => EditorParameterEvidence ?? Workbench.SelectedParameterEvidence;

    private static string PlainEnglishEvidence(ParameterEvidence evidence) => evidence.Name switch
    {
        "seed_opportunity_value" => "This changes how valuable the agent thinks an available seed opportunity is. In this recorded suite, larger values changed some decisions and rewards, so this is a useful knob to test carefully. The result applies to this suite; it is not a universal rule.",
        "pass_utility" => "This changes how attractive it feels to pass instead of planting. Positive values made the agent pass in situations where planting could still pay off in the recorded suite. That is why this knob is interesting, not proof that every positive value is bad.",
        _ when evidence.Result.Contains("inert", StringComparison.OrdinalIgnoreCase) => "The tested change did not make the agent choose a different action in this recorded suite. In other words, we moved this knob but the visible behavior stayed the same. That makes it lower priority for the next test, not permanently useless.",
        _ => $"The tested change produced this recorded result: {evidence.Result}. It tells us how the agent behaved in this bounded suite, but not how it must behave in every possible game.",
    };

    private string RunSelectionStory(ParameterEvidence evidence) =>
        $"We are testing the {evidence.Name} knob: the agent normally uses {evidence.Baseline}, and this run proposes changing it to {Workbench.Plan.ProposedValue:0.####}. {PlainEnglishEvidence(evidence)}";

    private RunStage? CurrentGuidanceStage =>
        Workbench.RunStages.FirstOrDefault(stage => stage.Id == activeStageId)
        ?? Workbench.RunStages.FirstOrDefault(stage => stage.Status == "current")
        ?? Workbench.RunStages.LastOrDefault(stage => stage.Status == "complete");

    private void SelectReceiptStage(string stageId) => activeStageId = stageId;

    private static string GuidanceTitle(RunStage stage) => stage.Id switch
    {
        "plan" => "First, we check the plan",
        "adapter" => "Next, we bind to the exact simulator version",
        "baseline" => "Next, we establish the baseline",
        "simulate" => "Now we run the candidates",
        "divergence" => "Now we compare what changed",
        "audit" => "Now we independently verify the result",
        "packet" => "The evidence packet is complete",
        "foundry" => "The local run is ready for Foundry review",
        _ => stage.Title,
    };

    private static string GuidanceText(RunStage stage) => stage.Id switch
    {
        "plan" => "We are checking that the graph, parameter, values, seeds, seats, and step count stay inside the approved envelope. Nothing runs during this check.",
        "adapter" => "We are making sure the simulator code is exactly the pinned revision that the experiment was approved against. This keeps the comparison fair.",
        "baseline" => "We are preparing the unchanged starting point. The baseline tells us what the agent does before we try a different parameter value.",
        "simulate" => "We are running the declared candidate values through the real local simulator. The policy source is not edited.",
        "divergence" => "We are finding the first decision where a candidate differs from the baseline and recording the remaining suffix that was replayed.",
        "audit" => "We are running a fresh full candidate match to make sure the faster checkpoint result is trustworthy.",
        "packet" => "The audited facts have been assembled into one immutable evidence packet for the human and Foundry agents to review.",
        "foundry" => "The deterministic evidence is ready. The separate Foundry review agents can now explain, judge, and propose the next bounded test.",
        _ => stage.Detail,
    };

    private string CurrentRunStatus(RunStage stage) =>
        string.IsNullOrWhiteSpace(status)
            ? $"{stage.Title}. {stage.Detail}"
            : status;

    private static string StageStateLabel(string status) => status switch
    {
        "complete" => "DONE",
        "current" => "CURRENT · NOT EXECUTED",
        "invalid" => "INVALID · FIX REQUIRED",
        _ => "TO DO · NOT EXECUTED",
    };

    private string StageDisplayStatus(RunStage stage) =>
        stage.Id == "plan" ? planValidationValid switch
        {
            true => "complete",
            false => "invalid",
            _ => "current",
        } : stage.Status;

    private static string StageDisplayMark(string status) => status switch
    {
        "complete" => "✓",
        "current" => "…",
        "invalid" => "!",
        _ => "○",
    };

    private string StageDisplayDetail(RunStage stage, string displayStatus) =>
        stage.Id == "plan" && displayStatus == "invalid" ? planValidationMessage : stage.Detail;

    private async Task ExecuteCurrentStep()
    {
        if (running) return;
        await ValidatePlanAsync();
        if (planValidationValid != true)
        {
            status = $"Run blocked: {planValidationMessage}";
            return;
        }
        running = true;
        status = "Preparing the approved Carrot run…";
        try
        {
            if (string.IsNullOrWhiteSpace(activeRunId))
            {
                var request = new BackendRunRequest(Workbench.Plan.GraphId, Workbench.Plan.ParameterName, Workbench.Plan.BaselineValue, Workbench.Plan.ProposedValue, [42], [0, 1], Workbench.Plan.Steps);
                using var response = await Backend.PostAsJsonAsync("api/runs", request);
                if (!response.IsSuccessStatusCode)
                {
                    var refusal = await response.Content.ReadAsStringAsync();
                    status = $"The runner refused the request ({(int)response.StatusCode}). {DescribeBackendRefusal(refusal)}";
                    return;
                }
                var planResult = await response.Content.ReadFromJsonAsync<BackendRunValidation>();
                if (planResult?.Receipt is null)
                {
                    status = "The backend returned no staged run receipt.";
                    return;
                }
                activeRunId = planResult.RunId;
                Workbench.ApplyStageReceipt(planResult.Receipt.Stages, "Plan validated; beginning the staged run.");
                activeStageId = planResult.Receipt.Stages.FirstOrDefault(stage => stage.Status == "current")?.Id ?? "baseline";
            }
            for (var step = 0; step < 6 && activeStageId != "foundry"; step++)
            {
                if (!await AdvanceRunStageAsync()) return;
            }
            status = "All executable stages completed. Foundry review remains a separate downstream step.";
        }
        catch (Exception error)
        {
            status = $"Runner unavailable: {error.Message}";
        }
        finally
        {
            running = false;
        }
    }

    private async Task<bool> AdvanceRunStageAsync()
    {
        if (string.IsNullOrWhiteSpace(activeRunId)) return false;
        status = $"Executing {activeStageId}…";
        using var response = await Backend.PostAsync($"api/runs/{activeRunId}/advance", null);
        var result = await response.Content.ReadFromJsonAsync<BackendRunValidation>();
        if (!response.IsSuccessStatusCode || result?.Receipt is null)
        {
            status = "The next execution stage could not be completed.";
            return false;
        }
        Workbench.ApplyStageReceipt(result.Receipt.Stages, $"Completed {activeStageId}.");
        activeStageId = result.Receipt.Stages.FirstOrDefault(stage => stage.Status == "current")?.Id ?? activeStageId;
        if (result.Receipt.CandidateResults is { Length: > 0 } && result.Receipt.PacketPath is not null)
        {
            var best = result.Receipt.CandidateResults.OrderByDescending(item => item.MeanPairedDecisionDelta).First();
            Workbench.RecordRunResult(new RunResultSummary(Workbench.Plan.ParameterName, Workbench.Plan.BaselineValue, result.Receipt.MatchCount, result.Receipt.CandidateCount, best.CandidateValue, best.MeanPairedDecisionDelta, best.DivergentMatchCount, result.Receipt.AuditsPassed, result.Receipt.PacketPath), "Evidence packet assembled from the staged run.");
        }
        return true;
    }

    private sealed record BackendRunRequest(string GraphId, string ParameterName, double BaselineValue, double ProposedValue, int[] Seeds, int[] Seats, int Steps);
    private sealed record BackendRunValidation(bool Valid, string RunId, string[] Errors, BackendRunReceipt? Receipt);
    private sealed record BackendCandidateResult(double CandidateValue, int MatchCount, double MeanPairedDecisionDelta, int DivergentMatchCount, bool AllAuditsPassed);
    private sealed record BackendRunReceipt(string RunId, string GraphId, string ExecutionMode, string Status, bool SourceMutation, RunStage[] Stages, string? TargetRevision, string? PacketPath, string? PacketSha256, int MatchCount, int CandidateCount, bool AuditsPassed, BackendCandidateResult[]? CandidateResults);

    private static string DescribeBackendRefusal(string body)
    {
        try
        {
            using var document = JsonDocument.Parse(body);
            if (document.RootElement.TryGetProperty("errors", out var errors) && errors.ValueKind == JsonValueKind.Array)
            {
                return string.Join(" ", errors.EnumerateArray().Select(error => error.GetString()).Where(text => !string.IsNullOrWhiteSpace(text)));
            }
        }
        catch (JsonException)
        {
            // Preserve the generic refusal when the backend did not return JSON.
        }
        return "The backend did not provide a structured reason.";
    }

    private void BackOneStep()
    {
        var index = Workbench.RunStages.ToList().FindIndex(stage => stage.Id == activeStageId);
        if (index <= 0) return;
        activeStageId = Workbench.RunStages[index - 1].Id;
        status = $"Viewing {Workbench.RunStages[index - 1].Title}.";
        Workbench.Plan.LastAction = status;
    }

    private async Task ForwardOneStep()
    {
        if (string.IsNullOrWhiteSpace(activeRunId))
        {
            status = "Run the validated plan first; there is no staged run to advance.";
            return;
        }
        await AdvanceRunStageAsync();
    }

    private bool IsLastReceiptTab =>
        Workbench.RunStages.Count == 0
        || Workbench.RunStages[^1].Id == activeStageId;

    private bool IsFirstReceiptTab =>
        Workbench.RunStages.Count == 0
        || Workbench.RunStages[0].Id == activeStageId;

    private void SelectParameter(ParameterEvidence item)
    {
        if (double.TryParse(item.Baseline, out var baseline))
        {
            editorParameterName = item.Name;
            editorBaselineValue = baseline;
            editorProposedValue = Workbench.Plan.ParameterName == item.Name && IsModified(item)
                ? Workbench.Plan.ProposedValue
                : baseline;
        }
        modalRelationKind = "parameter";
        modalRelationLabel = item.Name;
        modalRelationNodeKind = "parameter";
        showEditor = true;
        status = $"Selected {item.Name}. Review its recorded evidence and choose a proposed value.";
    }

    private void CloseEditor()
    {
        showEditor = false;
        ResetRelationToCommitted();
    }

    private void ResetRelationToCommitted()
    {
        modalRelationKind = "parameter";
        modalRelationLabel = Workbench.Plan.ParameterName;
        modalRelationNodeKind = "parameter";
    }

    private async Task CommitEditor()
    {
        if (EditorParameterEvidence is null) return;
        var existingModification = Workbench.SelectedParameterEvidence is { } current
            && IsModified(current);
        if (existingModification && editorParameterName != Workbench.Plan.ParameterName && !IsEditorModified)
        {
            // Opening another parameter is only a draft. Done without a new
            // value must not erase the already committed modification.
            status = $"No new value committed. {Workbench.Plan.ParameterName} remains the modified parameter.";
            showEditor = false;
            ResetRelationToCommitted();
            return;
        }
        Workbench.Plan.ParameterName = editorParameterName;
        Workbench.Plan.BaselineValue = editorBaselineValue;
        Workbench.Plan.ProposedValue = editorProposedValue;
        Workbench.Plan.LastAction = $"Committed one-parameter change: {editorParameterName} = {editorProposedValue:0.####}";
        status = $"Committed {editorParameterName} at {editorProposedValue:0.####}. Only this parameter will be sent to the runner.";
        showEditor = false;
        ResetRelationToCommitted();
        await ValidatePlanAsync();
    }

    private void ToggleSeat(int seat)
    {
        if (seat == 1) Workbench.Plan.SeatOneSelected = !Workbench.Plan.SeatOneSelected;
        if (seat == 2) Workbench.Plan.SeatTwoSelected = !Workbench.Plan.SeatTwoSelected;
        Workbench.Plan.LastAction = "Seat selection changed; no execution performed";
    }

    private void GraphChanged(ChangeEventArgs args)
    {
        Workbench.Plan.GraphId = args.Value?.ToString() ?? Workbench.Plan.GraphId;
        var graph = Workbench.Graphs.FirstOrDefault(item => item.Id == Workbench.Plan.GraphId);
        if (graph is null) return;
        Workbench.Plan.Crop = graph.DisplayName;
        Workbench.Plan.ParameterName = graph.ParameterName;
        Workbench.Plan.Opponent = graph.Opponent;
        var evidence = Workbench.ParametersForSelectedGraph.FirstOrDefault(item => item.Name == graph.ParameterName);
        if (evidence is not null && double.TryParse(evidence.Baseline, out var baseline))
        {
            Workbench.Plan.BaselineValue = baseline;
            Workbench.Plan.ProposedValue = baseline;
        }
        status = $"Selected {graph.DisplayName} graph. Review the parameter envelope before saving.";
    }

    private void ToggleScenario(string id)
    {
        var index = Workbench.TestScenarios.ToList().FindIndex(item => item.Id == id);
        if (index >= 0)
        {
            var current = Workbench.TestScenarios[index];
            var replacement = current with { Included = !current.Included };
            var mutable = Workbench.TestScenarios.ToList();
            mutable[index] = replacement;
            Workbench.ReplaceScenarios(mutable);
        }
    }
}
