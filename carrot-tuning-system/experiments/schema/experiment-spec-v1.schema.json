{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.kaggriculture-eval/schemas/experiment-spec-v1.schema.json",
  "title": "Kaggriculture bounded experiment specification v1",
  "description": "A source-controlled contract for one bounded, local counterfactual evaluation. It never authorizes source-policy mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "lifecycle_status",
    "decision_graph",
    "target",
    "parameter",
    "suite",
    "evaluation",
    "purpose",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$",
      "description": "Stable identifier; create a new identifier for a changed question."
    },
    "lifecycle_status": {
      "enum": [
        "draft",
        "approved",
        "historical_reproduction",
        "retired"
      ]
    },
    "decision_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "parameter_namespace", "actions", "eligibility_summary"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "parameter_namespace": {"type": "string", "minLength": 1},
        "actions": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "eligibility_summary": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_mode", "expected_revision", "expected_shared_sha256", "expected_engine_sha256"],
      "properties": {
        "binding_mode": {"const": "explicit_sibling_target"},
        "expected_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "expected_shared_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expected_engine_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "baseline_value", "candidate_values", "mutation_mode"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "baseline_value": {"type": "number"},
        "candidate_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number"}
        },
        "mutation_mode": {"const": "in_memory_single_field_override"}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opponent_id", "opponent_deterministic", "seeds", "seats", "steps"],
      "properties": {
        "opponent_id": {"type": "string", "minLength": 1},
        "opponent_deterministic": {"const": true},
        "seeds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0}
        },
        "seats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": [0, 1]}
        },
        "steps": {"type": "integer", "minimum": 1}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_policy", "reuse_no_divergence_baseline", "clean_audit_required", "result_storage"],
      "properties": {
        "checkpoint_policy": {"const": "before_every_decision"},
        "reuse_no_divergence_baseline": {"const": true},
        "clean_audit_required": {"const": true},
        "result_storage": {"const": "local_ignored_var_directory"}
      }
    },
    "baseline_cache_contract_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,127}$",
      "description": "Optional explicit identity of the approved baseline contract whose cache group this envelope may reuse."
    },
    "execution_authorization": {
      "type": "object",
      "description": "Optional machine-readable operation authority. An orchestrator must refuse an operation when this field is absent or does not list it.",
      "additionalProperties": false,
      "required": ["operations"],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "baseline_cache_preparation",
              "candidate_evidence_run"
            ]
          }
        }
      }
    },
    "purpose": {"type": "string", "minLength": 1},
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["human_decision_required", "source_policy_mutation_authorized", "candidate_expansion_authorized"],
      "properties": {
        "human_decision_required": {"const": true},
        "source_policy_mutation_authorized": {"const": false},
        "candidate_expansion_authorized": {"const": false}
      }
    },
    "historical_expectations": {
      "type": "object",
      "description": "Optional regression expectations for a completed historical experiment.",
      "additionalProperties": false,
      "required": ["baseline_mean_reward", "candidates", "all_clean_audits_passed"],
      "properties": {
        "baseline_mean_reward": {"type": "number"},
        "all_clean_audits_passed": {"const": true},
        "candidates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "classification", "mean_reward", "mean_paired_reward_delta", "clean_audits_passed"],
            "properties": {
              "value": {"type": "number"},
              "classification": {"enum": ["inert-at-scale", "directional-improvement", "directional-harm", "mixed-or-inconclusive"]},
              "mean_reward": {"type": "number"},
              "mean_paired_reward_delta": {"type": "number"},
              "clean_audits_passed": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recorded_from", "notes"],
      "properties": {
        "recorded_from": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
